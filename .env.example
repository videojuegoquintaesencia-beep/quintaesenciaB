# ───────────────────────────────────────────────────────────────
# Pieza Única — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ───────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa en emails, sitemap y metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (libSQL / SQLite).
#   Desarrollo: archivo local.   Producción: una base Turso (libsql://...) con su token.
DATABASE_URL=file:./data/pieza-unica.db
DATABASE_AUTH_TOKEN=

# Panel de administración (/admin)
#   ADMIN_PASSWORD: contraseña de acceso (mínimo 12 caracteres en producción).
#   SESSION_SECRET: cadena aleatoria larga (>= 32 caracteres) para firmar la sesión.
#                   Genera una con:  openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# PayPal (https://developer.paypal.com/dashboard/applications)
#   PAYPAL_ENV: "sandbox" para pruebas o "live" para cobrar de verdad.
#   Sin credenciales, en desarrollo la tienda funciona en MODO DEMOSTRACIÓN (pago simulado).
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Solo si activas el webhook de PayPal (recomendado en producción)
PAYPAL_WEBHOOK_ID=
# Permitir pagos simulados aunque NODE_ENV=production (NO usar con clientes reales)
ALLOW_DEMO_PAYMENTS=false
# Solo desarrollo/tests: apuntar la API de PayPal a un simulador local (se ignora en producción)
# PAYPAL_API_BASE=

# Nº de proxies propios delante de la app (Vercel, Nginx...). Se usa para detectar la IP real
# en los límites de peticiones. 0 = sin proxy (se ignoran las cabeceras X-Forwarded-For).
TRUSTED_PROXY_HOPS=1

# Email saliente (SMTP). Sin configurar, los emails se muestran en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que verá el cliente y dirección que recibe los avisos de pedidos/presupuestos
MAIL_FROM="Pieza Única <pedidos@tudominio.es>"
ADMIN_NOTIFY_EMAIL=
