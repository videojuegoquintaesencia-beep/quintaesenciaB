# ───────────────────────────────────────────────────────────────
# Pieza Única — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ───────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa en emails, sitemap y metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (libSQL / SQLite).
#   Desarrollo: archivo local.   Producción: una base Turso (libsql://...) con su token.
DATABASE_URL=file:./data/pieza-unica.db
DATABASE_AUTH_TOKEN=

# Panel de administración (/admin)
#   ADMIN_PASSWORD: contraseña de acceso. En producción se EXIGEN al menos 12 caracteres y que no sea trivial
#                   ("xxxxxxxxxxxx"); si no cumple, el panel queda desactivado y el arranque lo avisa en el registro.
#   SESSION_SECRET: cadena aleatoria larga (>= 32 caracteres) para firmar la sesión. Sin ella nadie puede entrar.
#                   Genera una con:  openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# PayPal (https://developer.paypal.com/dashboard/applications)
#   PAYPAL_ENV: "sandbox" para pruebas o "live" para cobrar de verdad.
#   Sin credenciales, en desarrollo la tienda funciona en MODO DEMOSTRACIÓN (pago simulado).
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook de PayPal. En producción es OBLIGATORIO para aceptar webhooks: sin él, /api/paypal/webhook responde 503
# (los pagos se siguen confirmando desde el navegador). Se verifica la firma de cada evento.
PAYPAL_WEBHOOK_ID=
# Permitir pagos simulados aunque NODE_ENV=production (NO usar con clientes reales)
ALLOW_DEMO_PAYMENTS=false
# Solo desarrollo/tests: apuntar la API de PayPal a un simulador local (se ignora en producción)
# PAYPAL_API_BASE=

# Nº de proxies PROPIOS delante de la app (Vercel = 1, Nginx + Vercel = 2...). Se usa para saber la IP real del cliente
# en los límites de peticiones: se toma la dirección que añadió el último proxy de confianza en X-Forwarded-For.
#   - Con el valor MAL puesto los límites por IP se pueden saltar (si pones 1 pero no hay proxy, el cliente elige su "IP").
#   - 0 = sin proxy delante: se ignoran las cabeceras y todos los visitantes comparten un único contador.
# Define este valor de forma explícita en producción (el arranque avisa si falta).
# El acceso al panel además tiene un tope GLOBAL (30 fallos cada 15 min entre todas las IP) que no depende de la IP.
TRUSTED_PROXY_HOPS=1

# Email saliente (SMTP). Sin configurar, en desarrollo los emails se muestran en la consola del servidor;
# en producción NO se envían (y su contenido no se escribe en el registro).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente que verá el cliente y dirección que recibe los avisos de pedidos/presupuestos
MAIL_FROM="Pieza Única <pedidos@tudominio.es>"
ADMIN_NOTIFY_EMAIL=
